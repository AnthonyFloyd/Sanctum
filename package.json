{
  "name": "sanctum",
  "version": "1.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "athanasioust",
  "description": "Sanctum — a local-first D&D 5e campaign manager for Dungeon Masters.",
  "main": "electron/main.js",
  "desktopName": "sanctum.desktop",
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs && node scripts/copy-leaflet.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/copy-leaflet.mjs",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "eslint",
    "electron": "electron .",
    "desktop:dev": "electron .",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:build:win": "node scripts/build-desktop.mjs --win",
    "desktop:build:linux": "node scripts/build-desktop.mjs --linux",
    "desktop:build:mac": "node scripts/build-desktop.mjs --mac",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.17",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "konva": "^10.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.5",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "electron": "^42.7.1",
    "electron-builder": "^26.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "@esbuild-kit/esm-loader": "npm:tsx@4.22.4",
    "global-agent": "4.1.8",
    "app-builder-lib": {
      "minimatch": "11.0.9"
    },
    "@electron/universal": {
      "minimatch": "11.0.9"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@13.2.0": true
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
